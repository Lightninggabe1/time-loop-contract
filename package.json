{
  "name": "time-loop-contract",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "verify": "npm run build && node scripts/shots.mjs --check --dist",
    "preview": "vite preview --port 4173",
    "assets": "node scripts/fetch-assets.mjs && node scripts/build-assets.mjs && node scripts/gen-textures.mjs && node scripts/bake-env.mjs && node scripts/prune-anims.mjs",
    "shots": "node scripts/shots.mjs",
    "profile": "node scripts/profile.mjs",
    "test": "vitest run && npm run verify && node scripts/walktest.mjs && node scripts/flows-hall.mjs"
  },
  "dependencies": {
    "@babylonjs/addons": "^9.31.0",
    "@babylonjs/core": "^9.31.0",
    "@babylonjs/havok": "^1.3.14",
    "@babylonjs/loaders": "^9.31.0",
    "@babylonjs/materials": "^9.31.0",
    "@recast-navigation/core": "^0.43.1",
    "@recast-navigation/generators": "^0.43.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^26.6.5",
    "meshoptimizer": "^1.3.0",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
