{
 "_doc": "Things the evening does by itself. Fire once per loop unless repeat:true. Times are game time.",
 "events": [
  {
   "id": "init.doors",
   "when": true,
   "do": [
    {
     "set": "door.study.locked"
    },
    {
     "set": "ledger.withCalloway"
    }
   ]
  },
  {
   "id": "hobbs.unlocks",
   "when": {
    "all": [
     {
      "after": "20:44"
     },
     {
      "before": "21:31"
     }
    ]
   },
   "do": [
    {
     "set": "door.study.locked",
     "value": false
    },
    {
     "set": "door.study.open"
    },
    {
     "say": "hobbs",
     "line": "The study is open for His Lordship."
    }
   ]
  },
  {
   "id": "hobbs.locks",
   "when": {
    "all": [
     {
      "after": "21:31"
     },
     {
      "not": {
       "flag": "door.study.player"
      }
     }
    ]
   },
   "do": [
    {
     "set": "door.study.open",
     "value": false
    },
    {
     "set": "door.study.locked"
    }
   ]
  },
  {
   "id": "ledger.in",
   "when": {
    "after": "21:05"
   },
   "do": [
    {
     "set": "ledger.inSafe"
    },
    {
     "set": "ledger.withCalloway",
     "value": false
    }
   ]
  },
  {
   "id": "ledger.out",
   "when": {
    "all": [
     {
      "after": "23:05"
     },
     {
      "flag": "ledger.inSafe"
     }
    ]
   },
   "do": [
    {
     "set": "ledger.inSafe",
     "value": false
    },
    {
     "set": "ledger.carried"
    }
   ]
  },
  {
   "id": "ledger.missing",
   "when": {
    "all": [
     {
      "after": "23:04"
     },
     {
      "flag": "has.ledger"
     },
     {
      "not": {
       "flag": "c1.loud"
      }
     },
     {
      "not": {
       "flag": "c1.chaos"
      }
     }
    ]
   },
   "do": [
    {
     "say": "calloway",
     "line": "My ledger! Who's been in my safe?!"
    }
   ]
  },
  {
   "id": "credit.safe",
   "when": {
    "flag": "ledger.taken.safe"
   },
   "do": [
    {
     "set": "c1.quiet"
    }
   ]
  },
  {
   "id": "credit.safe.social",
   "when": {
    "all": [
     {
      "flag": "ledger.taken.safe"
     },
     {
      "flag": "blackmail.calloway"
     }
    ]
   },
   "do": [
    {
     "set": "c1.social"
    },
    {
     "set": "c1.quiet",
     "value": false
    }
   ]
  },
  {
   "id": "dark.safe",
   "when": {
    "all": [
     {
      "flag": "lights.out"
     },
     {
      "after": "23:00"
     },
     {
      "before": "23:09"
     },
     {
      "not": {
       "flag": "has.ledger"
      }
     }
    ]
   },
   "do": [
    {
     "set": "ledger.dropped"
    },
    {
     "set": "ledger.inSafe",
     "value": false
    },
    {
     "say": "calloway",
     "line": "Who turned out the\u2014I've dropped it! Where's my ledger?"
    }
   ]
  },
  {
   "id": "dark.song",
   "when": {
    "all": [
     {
      "flag": "lights.out"
     },
     {
      "after": "21:58"
     },
     {
      "before": "22:06"
     },
     {
      "not": {
       "flag": "song.cancelled"
      }
     }
    ]
   },
   "do": [
    {
     "set": "song.cancelled"
    },
    {
     "set": "c2.chaos"
    },
    {
     "say": "dolly",
     "line": "I am NOT singing in the dark!"
    },
    {
     "npc": "dolly",
     "override": {
      "state": "distracted",
      "goto": "tower3",
      "until": 1350
     }
    }
   ]
  },
  {
   "id": "song.dead_mic",
   "when": {
    "all": [
     {
      "after": "22:01"
     },
     {
      "flag": "mic.cut"
     },
     {
      "not": {
       "flag": "song.cancelled"
      }
     }
    ]
   },
   "do": [
    {
     "set": "song.cancelled"
    },
    {
     "set": "c2.quiet"
    },
    {
     "say": "dolly",
     "line": "Is this thing on? ...Hello? FINE."
    },
    {
     "npc": "dolly",
     "override": {
      "state": "distracted",
      "goto": "tower3",
      "until": 1350
     }
    }
   ]
  },
  {
   "id": "song.lured",
   "when": {
    "all": [
     {
      "after": "22:01"
     },
     {
      "flag": "dolly.lured"
     },
     {
      "not": {
       "flag": "song.cancelled"
      }
     }
    ]
   },
   "do": [
    {
     "set": "song.cancelled"
    },
    {
     "set": "c2.social"
    },
    {
     "say": "hobbs",
     "line": "Ladies and gentlemen, Miss Vane is... indisposed."
    }
   ]
  },
  {
   "id": "song.brawl",
   "when": {
    "all": [
     {
      "after": "22:01"
     },
     {
      "flag": "brawl"
     },
     {
      "not": {
       "flag": "song.cancelled"
      }
     }
    ]
   },
   "do": [
    {
     "set": "song.cancelled"
    },
    {
     "set": "c2.loud"
    },
    {
     "say": "dolly",
     "line": "I don't sing for hooligans!"
    },
    {
     "npc": "dolly",
     "override": {
      "state": "distracted",
      "goto": "tower3",
      "until": 1350
     }
    }
   ]
  },
  {
   "id": "song.sung",
   "when": {
    "all": [
     {
      "after": "22:02"
     },
     {
      "not": {
       "flag": "song.cancelled"
      }
     }
    ]
   },
   "do": [
    {
     "set": "song.performed"
    },
    {
     "say": "dolly",
     "line": "\u266a Happy days are here again... \u266a"
    }
   ]
  },
  {
   "id": "ashcombe.alone",
   "when": {
    "all": [
     {
      "after": "22:30"
     },
     {
      "before": "22:56"
     },
     {
      "flag": "player.near.ashcombe"
     }
    ]
   },
   "do": [
    {
     "set": "seen.ashcombe.alone"
    }
   ]
  },
  {
   "id": "toast.ko",
   "when": {
    "all": [
     {
      "after": "23:49"
     },
     {
      "flag": "ko.ashcombe"
     },
     {
      "not": {
       "flag": "c3.quiet"
      }
     },
     {
      "not": {
       "flag": "c3.social"
      }
     },
     {
      "not": {
       "flag": "c3.chaos"
      }
     }
    ]
   },
   "do": [
    {
     "set": "c3.loud"
    },
    {
     "say": "hobbs",
     "line": "His Lordship is... resting. No toast this year, I'm afraid."
    }
   ]
  },
  {
   "id": "toast.chandelier",
   "when": {
    "all": [
     {
      "flag": "chandelier.dropped"
     },
     {
      "after": "23:50"
     },
     {
      "before": "23:59"
     },
     {
      "not": {
       "flag": "c3.quiet"
      }
     },
     {
      "not": {
       "flag": "c3.social"
      }
     },
     {
      "not": {
       "flag": "ko.ashcombe"
      }
     }
    ]
   },
   "do": [
    {
     "set": "c3.chaos"
    },
    {
     "npc": "ashcombe",
     "override": {
      "state": "ko",
      "until": 1440
     }
    },
    {
     "say": "ashcombe",
     "line": "My chandelier! *faints*"
    }
   ]
  },
  {
   "id": "toast.given",
   "when": {
    "all": [
     {
      "after": "23:55"
     },
     {
      "not": {
       "flag": "c3.quiet"
      }
     },
     {
      "not": {
       "flag": "c3.social"
      }
     },
     {
      "not": {
       "flag": "c3.loud"
      }
     },
     {
      "not": {
       "flag": "c3.chaos"
      }
     }
    ]
   },
   "do": [
    {
     "set": "toast.given"
    },
    {
     "say": "ashcombe",
     "line": "To 1930! And to Mr Calloway, the new owner of Ashcombe Manor!"
    }
   ]
  },
  {
   "id": "five.to",
   "when": {
    "after": "23:55"
   },
   "do": [
    {
     "toast": "Five to midnight."
    }
   ]
  },
  {
   "id": "ten.pm",
   "when": {
    "after": "22:00"
   },
   "do": [
    {
     "toast": "Ten o'clock."
    }
   ]
  }
 ]
}